from flask import Flask, request
import random
app = Flask(__name__)

@app.route('/lottery', methods=['GET', 'POST'])
def lottery():
    if request.method == 'GET':
        html = """<form method='POST'>
        <textarea name="students" rows=4 cols=50></textarea><br>
        Number of Samples:
        <select name=sample>
            <option value=1>1</option>
            <option value=2>2</option>
            <option value=3>3</option>
        </select>
        <input type=submit> <input type=reset>"""
        return html
    else:   # POST
        students = request.values['students'].split("\r\n")
        sample = int(request.values['sample'])
        list = random.sample(students, sample)
        html = '''Students: <ol>\n'''
        for student in list:
            html += f'<li>{student}</li>\n'
        html += '</ol>'
        return html
